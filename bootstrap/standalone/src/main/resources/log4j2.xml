<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <TerminalConsole name="TerminalConsole">
            <PatternLayout pattern="[%d{HH:mm:ss} %style{%highlight{%level}{FATAL=red, ERROR=red, WARN=yellow bright, INFO=cyan bright, DEBUG=green, TRACE=white}}] %minecraftFormatting{%msg}%n"/>
        </TerminalConsole>
        <RollingRandomAccessFile name="File" fileName="logs/latest.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="[%d{HH:mm:ss.SSS} %t/%level] %minecraftFormatting{%msg}{strip}%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <OnStartupTriggeringPolicy/>
            </Policies>
        </RollingRandomAccessFile>
    </Appenders>
    <Loggers>
        <!-- Geyser already logs a concise message for this expected auth-refresh
             failure (see PortalBridgeBootstrap#reloadSignalingIfAuthChanged); the
             library's own logger repeats it with a full stacktrace every 2s while
             the token stays invalid, so silence it here. -->
        <Logger name="dev.kastle.netty.channel.nethernet.signaling.NetherNetXboxRpcSignaling" level="OFF"/>
        <Root level="INFO" >
            <AppenderRef ref="TerminalConsole"/>
            <AppenderRef ref="File"/>
            <filters>
                <MarkerFilter marker="packet_logging" onMatch="DENY" onMismatch="ACCEPT" />
            </filters>
        </Root>
    </Loggers>
</Configuration>
